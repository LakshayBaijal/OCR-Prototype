{
  "title": "ONDC Product Record",
  "fields": [
    { "name": "Product Name", "type": "string", "required": true },
    { "name": "Brand", "type": "string" },
    { "name": "Fssai No", "type": "string", "description": "14-digit FSSAI license number printed on food packaging" },
    { "name": "Herbal/ Ayurvedic", "type": "boolean" },
    { "name": "Preservatives (details)", "type": "string" },
    { "name": "Preservatives (y/n)", "type": "boolean" },
    { "name": "Ready To Cook (y/n)", "type": "boolean" },
    { "name": "Ready To Eat (y/n)", "type": "boolean" },
    { "name": "Scented/ Flavour", "type": "string" },
    { "name": "Rice Grain Type", "type": "string" },
    { "name": "Baby Weight", "type": "string" },
    { "name": "Absorption Duration (in Hrs)", "type": "number" },
    { "name": "Pack Quantity", "type": "string", "description": "e.g. 'Pack of 1'" },
    { "name": "Mineral Source", "type": "string" },
    { "name": "Capacity", "type": "string" },
    { "name": "Product Quantity", "type": "string" },
    { "name": "Upc / Ean", "type": "string", "description": "Barcode number, usually under the barcode" },
    { "name": "Manufacturer", "type": "string" },
    { "name": "Customer Care Contact", "type": "string" },
    { "name": "Flavours & Spices", "type": "string" },
    { "name": "Recommended Age", "type": "string" },
    { "name": "Mrp", "type": "number", "description": "Maximum Retail Price in rupees" },
    { "name": "Country Of Origin", "type": "string" },
    { "name": "Product - Unit Of Measurement", "type": "string", "description": "e.g. ml, gm, kg, l" },
    { "name": "Product Description", "type": "string" },
    { "name": "Net Quantity", "type": "string" },
    { "name": "Theme/ Occasion Type", "type": "string" },
    { "name": "Hair Type", "type": "string" },
    { "name": "Caffeine Content", "type": "string" }
  ]
}
